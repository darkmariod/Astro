---
const plans = [
  {
    name: 'Landing',
    for: 'Para el negocio con un solo objetivo: que lo llamen.',
    price: '$250',
    priceNote: 'Proyecto',
    featured: false,
    features: [
      'Una página de hasta 6 secciones',
      'Dominio, hosting y SSL incluidos',
      'Botón de WhatsApp y formulario de contacto',
      'Optimizada para carga rápida',
    ],
  },
  {
    name: 'Página web',
    for: 'Para el negocio con varios servicios que necesita explicarlos.',
    price: '$350',
    priceNote: 'Proyecto',
    featured: true,
    features: [
      'Hasta 6 páginas',
      'Dominio, hosting y SSL incluidos',
      'Secciones administrables',
      'SEO configurado página por página',
    ],
  },
  {
    name: 'Tienda en línea',
    for: 'Para el negocio que quiere vender online.',
    price: '$300',
    priceNote: 'Proyecto',
    featured: false,
    features: [
      'Catálogo de productos',
      'Carrito y pagos en línea',
      'Panel para gestionar productos y pedidos',
      'Dominio, hosting y SSL incluidos',
    ],
  },
];
---

<section class="pricing section" id="planes">
  <div class="container">
    <div class="pricing__header reveal">
      <p class="eyebrow">Planes</p>
      <h2 class="display-lg">Cómo trabajamos</h2>
    </div>

    <div class="pricing__grid">
      {plans.map((plan) => (
        <div class={`plan reveal ${plan.featured ? 'plan--featured' : ''}`}>
          {plan.featured && <span class="plan__badge">Más elegido</span>}
          <h3 class="plan__name">{plan.name}</h3>
          <p class="plan__for">{plan.for}</p>

          <div class="plan__price">
            <span class="plan__amount">{plan.price}</span>
            <span class="plan__note">{plan.priceNote}</span>
          </div>

          <ul class="plan__features">
            {plan.features.map((f) => (
              <li class="plan__feature">
                <span class="plan__check" aria-hidden="true">✓</span>
                {f}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="pricing__note reveal">Precios en USD. Cada proyecto puede ajustarse según lo que necesites.</p>
  </div>
</section>

<style>
  .pricing__header {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .pricing__header h2 { margin-top: 0.75rem; }

  .pricing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .pricing__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 980px) {
    .pricing__grid { grid-template-columns: repeat(3, 1fr); }
  }

  .plan {
    position: relative;
    padding: 1.9rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
  }

  .plan--featured { border-color: var(--accent); }

  .plan__badge {
    position: absolute;
    top: -0.75rem;
    left: 1.9rem;
    padding: 0.3rem 0.75rem;
    background: var(--accent);
    color: #0a0a0b;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .plan__name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .plan__for {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
    min-height: 2.8em;
  }

  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 1.5rem 0;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .plan__amount {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .plan__note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .plan__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .plan__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .plan__check {
    color: var(--accent);
    font-weight: 700;
    flex-shrink: 0;
  }

  .pricing__note {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>

---
const stack = [
  { name: 'Laravel', lead: true },
  { name: 'PHP', lead: false },
  { name: 'Vue', lead: false },
  { name: 'Python', lead: false },
];
---

<section class="tech section" id="tecnologia">
  <div class="container">
    <p class="eyebrow reveal">Tecnología</p>
    <div class="tech__row reveal">
      {stack.map((t) => (
        <span class={`tech__item ${t.lead ? 'tech__item--lead' : ''}`}>{t.name}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .tech .eyebrow { margin-bottom: 1.25rem; }

  .tech__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: clamp(1.25rem, 4vw, 2.75rem);
  }

  .tech__item {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3.5vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .tech__item:hover { color: var(--text-secondary); }

  .tech__item--lead {
    color: var(--text-primary);
    font-size: clamp(1.7rem, 4.5vw, 2.9rem);
    font-weight: 700;
  }

  .tech__item--lead::after {
    content: '';
    display: block;
    height: 2px;
    width: 100%;
    margin-top: 0.35rem;
    background: var(--accent);
    border-radius: 2px;
  }
</style>

---
const items = [
  { name: 'Desarrollo de sistemas web', desc: 'Aplicaciones web a medida para operar tu negocio.' },
  { name: 'Sistemas de inventario y ventas', desc: 'Control de productos, stock y ventas en un panel.' },
  { name: 'Reservas y gestión de citas', desc: 'Agenda online para servicios, turnos y horarios.' },
  { name: 'Facturación electrónica SRI', desc: 'Comprobantes válidos emitidos desde tu propio sistema.' },
  { name: 'Software a medida', desc: 'Lo que tu proceso necesite, construido desde cero.' },
];
---

<section class="services section" id="servicios">
  <div class="container">
    <div class="services__header reveal">
      <p class="eyebrow">Servicios</p>
      <h2 class="display-lg">Qué puedo construir</h2>
    </div>

    <ul class="services__list">
      {items.map((it) => (
        <li class="service-row reveal">
          <span class="service-row__name">{it.name}</span>
          <span class="service-row__desc">{it.desc}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services__header {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .services__header h2 { margin-top: 0.75rem; }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-subtle);
  }

  .service-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    padding: clamp(1.1rem, 2.5vw, 1.6rem) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 720px) {
    .service-row {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 2rem;
      align-items: baseline;
    }
  }

  .service-row__name {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.5vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .service-row__desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }
</style>

---
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist/700.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '../styles/landing.css';

import Nav from '../components/react/Nav.jsx';
import Hero from '../components/landing/Hero.astro';
import Projects from '../components/landing/Projects.astro';
import Verticals from '../components/landing/Verticals.astro';
import Tech from '../components/landing/Tech.astro';
import Pricing from '../components/landing/Pricing.astro';
import Process from '../components/landing/Process.astro';
import Faq from '../components/landing/Faq.astro';
import ContactForm from '../components/landing/ContactForm.astro';
import Footer from '../components/landing/Footer.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <meta name="description" content="Software a medida en Ecuador: sistema contable con facturación electrónica SRI, reservas para barberías, tiendas online y páginas web que venden. Hecho con Laravel. Cotiza por WhatsApp." />
    <meta name="keywords" content="desarrollo de software Ecuador, software a medida, sistema contable Ecuador, facturación electrónica SRI, sistema de reservas para barberías, tienda online Ecuador, página web Ecuador, Laravel, PHP, Monkey Computer" />
    <meta name="author" content="Monkey Computer" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="geo.region" content="EC" />
    <meta name="geo.placename" content="Ecuador" />

    <!-- Open Graph -->
    <meta property="og:title" content="Monkey Computer | Software a medida y páginas web en Ecuador" />
    <meta property="og:description" content="Sistema contable con facturación SRI, reservas para barberías, tiendas online y software a medida. Cotiza por WhatsApp." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://monkeycomputer.com" />
    <meta property="og:site_name" content="Monkey Computer" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:image" content="https://monkeycomputer.com/logo.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Monkey Computer | Software a medida y páginas web en Ecuador" />
    <meta name="twitter:description" content="Sistema contable con facturación SRI, reservas para barberías, tiendas online y software a medida. Cotiza por WhatsApp." />
    <meta name="twitter:image" content="https://monkeycomputer.com/logo.png" />

    <!-- Canonical -->
    <link rel="canonical" href="https://monkeycomputer.com" />

    <link rel="icon" type="image/png" href="/logo.png" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Monkey Computer",
        "url": "https://monkeycomputer.com",
        "logo": "https://monkeycomputer.com/logo.png",
        "image": "https://monkeycomputer.com/logo.png",
        "description": "Desarrollo de software a medida en Ecuador: sistema contable con facturación electrónica SRI, sistemas de reservas para barberías, tiendas online y páginas web.",
        "priceRange": "$$",
        "areaServed": { "@type": "Country", "name": "Ecuador" },
        "address": { "@type": "PostalAddress", "addressCountry": "EC" },
        "sameAs": [
          "https://github.com/MonkeyComputer593",
          "https://www.linkedin.com/company/monkey-computer/",
          "https://www.instagram.com/monkey.computer.ec/"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Servicios de software",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sistema contable y facturación electrónica SRI" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sistema de reservas para barberías" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tienda en línea / e-commerce" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Páginas web y sitios informativos" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Software a medida con Laravel" } }
          ]
        }
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Monkey Computer",
        "url": "https://monkeycomputer.com",
        "inLanguage": "es-EC",
        "description": "Software a medida, sistema contable con facturación SRI, reservas para barberías, tiendas online y páginas web en Ecuador."
      }
    </script>

    <title>Monkey Computer | Software a medida y páginas web en Ecuador</title>

    <style is:global>
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>
  <body class="landing-body">
    <Nav client:load />
    
    <main id="main-content">
      <Hero />
      <Projects />
      <Verticals />
      <Tech />
      <Pricing />
      <Process />
      <Faq />
      <ContactForm />
    </main>
    <Footer />

    <button
      id="scroll-top"
      aria-label="Volver arriba"
      data-i18n-aria="nav.scrollTopAria"
      title="Volver arriba"
      data-i18n-title="nav.scrollTopTitle"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <script src="../scripts/main.js"></script>
  </body>
</html>
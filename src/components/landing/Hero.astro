---
---

<section class="hero" id="home">
  <div class="hero__bg" aria-hidden="true"></div>

  <div class="container">
    <div class="hero__center">
      <!-- Badge simple -->
      <div class="hero__badge reveal">
      </div>

      <!-- Title - ESTILO PREMIUM: corto, fuerte, orientado a negocio -->
      <h1 class="display-xl hero__title reveal">
        <span data-i18n="heroAlt.title">Sistemas digitales</span><br/>
      </h1>

      <!-- Subheadline - lenguaje de negocio, NO técnico -->
      <p class="hero__desc reveal" data-i18n="heroAlt.subtitle">
     Que automatizan negocios..
      </p>

      <!-- CTAs - lenguaje de conversión -->
      <div class="hero__actions reveal">
        <a href="#contacto" class="btn btn-primary btn-lg btn-hero">
          <span data-i18n="heroAlt.ctaPrimary">Quiero más clientes</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
          </svg>
        </a>
        <a href="#projects" class="btn btn-secondary btn-lg btn-hero">
          <span data-i18n="heroAlt.ctaSecondary">Ver casos</span>
        </a>
      </div>
    </div>
  </div>
</section>

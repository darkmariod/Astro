---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="divider"></div>
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href="#home" class="footer__logo">Monkey Computer</a>
      <p class="footer__tagline">Desarrollo de software para negocios.</p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <a href="#projects" class="footer__link">Proyectos</a>
      <a href="#sobre-mi" class="footer__link">Sobre mí</a>
      <a href="#contacto" class="footer__link">Contacto</a>
    </nav>

    <nav class="footer__social" aria-label="Redes">
      <a href="https://github.com/MonkeyComputer593" target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label="GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.509 11.509 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <a href="https://www.linkedin.com/company/monkey-computer/" target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label="LinkedIn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.883-.382-3.637-2.382-3.637-2.382 0-2.786 1.754-2.786 3.637v5.569h-3.554v-11h3.554v1.561h.049c.475-.9 1.637-1.848 3.055-1.848 2.963 0 3.397 1.894 3.397 4.574v6.437zM5.337 7.433c-1.145 0-2.073-.928-2.073-2.073 0-1.146.928-2.074 2.073-2.074 1.146 0 2.074.928 2.074 2.074 0 1.145-.928 2.073-2.074 2.073zm1.778 13.019H3.555v-11h3.56v11z"/>
        </svg>
      </a>
    </nav>
  </div>

  <div class="container footer__bottom">
    <p class="footer__legal">&copy; {year} Monkey Computer</p>
  </div>
</footer>

<style>
  .footer { padding-bottom: 2.5rem; }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    padding-block: 2.5rem;
  }

  .footer__logo {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-decoration: none;
  }

  .footer__tagline {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer__link {
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__link:hover { color: var(--text-primary); }

  .footer__social {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer__social-link {
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .footer__social-link:hover { color: var(--text-primary); }

  .footer__bottom {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .footer__legal {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .footer__inner { flex-direction: column; align-items: flex-start; }
  }
</style>

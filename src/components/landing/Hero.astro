---
const WHATSAPP_URL =
  "https://wa.me/5491136000797?text=Hola,%20quiero%20conversar%20sobre%20un%20proyecto%20de%20software.";
---

<section class="hero" id="home">
  <div class="container hero__inner">
    <p class="hero__eyebrow reveal">Desarrollo de software ·</p>

    <h1 class="display-xl hero__title reveal">
      Software para <span class="gradient-text">negocios reales.</span>
    </h1>

    <p class="hero__desc reveal">
      Desarrollo sistemas web que digitalizan procesos, automatizan tareas
      y ayudan a los negocios a trabajar mejor.
    </p>

    <div class="hero__actions reveal">
      <a href="#projects" class="btn btn-primary btn-lg">Ver proyectos</a>
      <a href={WHATSAPP_URL} class="btn btn-secondary btn-lg" target="_blank" rel="noopener noreferrer">
        Trabajemos juntos
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4.5rem, 12vw, 9rem) clamp(3.5rem, 8vw, 6rem);
  }

  .hero__inner {
    max-width: 900px;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .hero__title {
    margin-bottom: 1.75rem;
    max-width: 16ch;
  }

  .hero__desc {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 46ch;
    margin-bottom: 2.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
</style>

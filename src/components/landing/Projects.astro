---
import etsaatours from '../../assets/etsaatours.png';
import ecommerce from '../../assets/ecommerce.png';
import reservation from '../../assets/reservation.png';

const projects = [
  {
    image: etsaatours.src,
    tag: 'Página Web',
    client: 'ETSAA Tours',
    problem: 'Necesitaba presencia digital para captar turistas',
    solution: 'Web profesional con diseño premium',
    result: 'Web visible y atrayendo clientes',
  },
  {
    image: ecommerce.src,
    tag: 'E-commerce',
    client: 'E-Commerce',
    problem: 'Digitalizar sus ventas en línea',
    solution: 'Tienda online moderna con catálogo y pagos',
    result: 'Ventas automatizadas sin intervención',
  },
  {
    image: reservation.src,
    tag: 'Sistema de Reservas',
    client: 'Reservas',
    problem: 'Gestión manual de reservas y turnos',
    solution: 'Sistema digital con google calendar y  gestión de pagos',
    result: 'Reservas 24/7 sin errores humanos',
  },
];
---

<section class="projects section" id="projects">
  <div class="container">
    <div class="projects__header reveal">
      <p class="eyebrow" data-i18n="projectsAlt.eyebrow">Casos de Éxito</p>
      <h2 class="display-lg">
        <span data-i18n="projectsAlt.headline1">Proyectos que</span><br/>
        <span class="gradient-text" data-i18n="projectsAlt.headline2">generan resultados.</span>
      </h2>
    </div>

    <div class="cases__grid">
      {projects.map((project, index) => (
        <a href="#contacto" class={`case-card reveal ${index === 1 ? 'reveal-delay-1' : ''}`}>
          <div class="case-card__image" style={`background-image: url('${project.image}')`}></div>

          <div class="case-card__header">
            <span class="case-card__tag" data-i18n={`projectsAlt.p${index + 1}Tag`}>{project.tag}</span>
          </div>
          <h3 class="case-card__client" data-i18n={`projectsAlt.p${index + 1}Client`}>{project.client}</h3>

          <div class="case-card__content">
            <div class="case-item">
              <span class="case-item__label" data-i18n="projectsAlt.labelProblem">Problema</span>
              <p data-i18n={`projectsAlt.p${index + 1}Problem`}>{project.problem}</p>
            </div>
            <div class="case-item">
              <span class="case-item__label" data-i18n="projectsAlt.labelSolution">Solución</span>
              <p data-i18n={`projectsAlt.p${index + 1}Solution`}>{project.solution}</p>
            </div>
            <div class="case-item case-item__result">
              <span class="case-item__label" data-i18n="projectsAlt.labelResult">Resultado</span>
              <p data-i18n={`projectsAlt.p${index + 1}Result`}>{project.result}</p>
            </div>
          </div>
        </a>
      ))}
    </div>


</section>

<style>
  .projects {
    background: var(--bg-surface);
    padding: var(--section-py) 0;
  }

  .projects__header {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .projects__header h2 span:first-child {
    display: block;
  }

  @media (min-width: 768px) {
    .projects__header h2 span:first-child {
      display: inline;
    }
  }

  /* Grid 2x2 estilo casos */
  .cases__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 800px;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .cases__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .case-card {
    display: block;
    padding: 0;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    text-decoration: none;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .case-card:hover {
    transform: translateY(-4px) scale(1.02);
    border-color: var(--accent);
    box-shadow: 0 20px 40px rgba(209, 160, 255, 0.15);
  }

  /* Imagen del caso - editable desde código */
  .case-card__image {
    width: 100%;
    height: 160px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .case-card__info {
    padding: 1.5rem;
  }

  .case-card__header {
    margin-bottom: 0.75rem;
  }

  .case-card__tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--accent-soft);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent);
  }

  .case-card__client {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
    padding: 0 1.5rem;
  }

  .case-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .case-item__label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
    padding: 0 1.5rem;
  }

  .case-item p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.4;
    padding: 0 1.5rem;
  }

  .case-item__result {
    padding: 0.75rem 1.5rem 1.5rem;
    margin-top: 0.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .case-item__result p {
    padding: 0;
  }

  .case-item__result .case-item__label {
    color: var(--accent);
  }

  .case-item__result p {
    color: var(--text-primary);
    font-weight: 500;
  }
</style>
